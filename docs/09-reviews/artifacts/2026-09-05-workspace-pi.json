  "clientSource": "/**\n * Fetch every order from the /orders endpoint by following pagination.\n *\n * Implements ../backend/contract.json (shared source of truth):\n *   request:  { cursor: opaque cursor string, or null for the first page }\n *   response: { items: array of { id: string }, next_cursor: opaque cursor string or null when there are no more pages }\n *\n * @param {(request: { cursor: string | null }) => Promise<{ items: Array<{ id: string }>, next_cursor: string | null }>} fetchPage\n * @returns {Promise<Array<{ id: string }>>} flat array of items across all pages\n */\nexport async function fetchAll(fetchPage) {\n  const items = [];\n  let cursor = null;\n\n  do {\n    const data = await fetchPage({ cursor });\n    items.push(...data.items);\n    cursor = data.next_cursor;\n  } while (cursor != null);\n\n  return items;\n}\n"
}
