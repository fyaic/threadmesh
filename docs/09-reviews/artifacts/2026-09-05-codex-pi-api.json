  "receiverArtifact": {
    "path": "client/client.mjs",
    "content": "// Client for the /orders paginated API.\n// Contract (../backend/contract.json):\n//   request:  { cursor: string or null; null for the first page }\n//   response: { items: array of { id: string }, next_cursor: string or null; null at the end }\n\nexport async function fetchAll(fetchPage) {\n  const items = [];\n  let cursor = null; // null requests the first page\n\n  for (;;) {\n    const data = await fetchPage({ cursor });\n    for (const item of data.items) {\n      items.push(item);\n    }\n    if (data.next_cursor == null) break; // null signals the last page\n    cursor = data.next_cursor;\n  }\n\n  return items;\n}\n"
  },
