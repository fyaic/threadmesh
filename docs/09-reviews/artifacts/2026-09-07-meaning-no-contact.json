    "content": "// Fetches every /orders page through the injected fetchPage and returns a flat\n// array of items. See ../backend/contract.json (source of truth):\n//   request:  { page: integer starting at 1 }\n//   response: { items: array of { id: string }, next_page: integer or null }\nexport async function fetchAll(fetchPage) {\n  const items = [];\n  let page = 1;\n  do {\n    const data = await fetchPage({ page });\n    items.push(...data.items);\n    page = data.next_page;\n  } while (page != null);\n  return items;\n}\n"
