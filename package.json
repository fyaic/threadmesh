{
  "name": "threadmesh",
  "version": "0.0.0",
  "private": true,
  "description": "Protocol schemas and conformance kit for safe cross-task agent coordination",
  "type": "module",
  "scripts": {
    "validate:spec": "node scripts/validate-spec.mjs",
    "lint:docs": "markdownlint-cli2 'README*.md' 'docs/**/*.md' 'spec/**/*.md' '*.md'",
    "test:unit": "node --test test/*.test.mjs",
    "smoke:codex": "node scripts/smoke-codex.mjs",
    "smoke:codex:live": "THREADMESH_CODEX_LIVE=1 node scripts/smoke-codex.mjs",
    "smoke:kimi": "node scripts/smoke-kimi.mjs",
    "smoke:kimi:live": "THREADMESH_KIMI_LIVE=1 node scripts/smoke-kimi.mjs",
    "test": "npm run validate:spec && npm run test:unit && npm run lint:docs"
  },
  "devDependencies": {
    "ajv": "8.20.0",
    "ajv-formats": "3.0.1",
    "markdownlint-cli2": "0.23.2"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "@agentclientprotocol/sdk": "1.3.0",
    "better-sqlite3": "13.0.3"
  }
}
