{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://threadmesh.dev/spec/0.0-draft/jsonrpc.schema.json",
  "title": "ThreadMesh JSON-RPC 2.0 binding",
  "oneOf": [
    { "$ref": "#/$defs/request" },
    { "$ref": "#/$defs/response" }
  ],
  "$defs": {
    "rpcId": { "type": ["string", "integer"] },
    "idempotencyKey": {
      "type": "string",
      "pattern": "^idem_[A-Za-z0-9][A-Za-z0-9._:-]{4,190}$"
    },
    "response": {
      "oneOf": [
        { "$ref": "#/$defs/successResponse" },
        { "$ref": "#/$defs/errorResponse" }
      ]
    },
    "taskInput": {
      "type": "object",
      "additionalProperties": false,
      "required": ["taskId", "incarnationId", "harness"],
      "properties": {
        "taskId": { "type": "string", "minLength": 1, "maxLength": 200 },
        "incarnationId": {
          "type": "string",
          "pattern": "^inc_[A-Za-z0-9][A-Za-z0-9._:-]{6,196}$"
        },
        "harness": { "type": "string", "minLength": 1, "maxLength": 200 },
        "state": {
          "enum": ["idle", "running", "waiting", "blocked", "completed", "failed", "interrupted", "archived", "unknown"]
        },
        "adapterRef": { "type": "object", "minProperties": 1, "maxProperties": 32 }
      }
    },
    "grantDraft": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "specVersion", "grantId", "grantVersion", "relationshipId",
        "relationshipType", "source", "target", "allowedIntents",
        "allowedDeliveryModes", "summaryVisibility",
        "structuredGateResponses", "createdAt"
      ],
      "properties": {
        "specVersion": { "const": "0.0-draft" },
        "grantId": { "type": "string", "pattern": "^grant_[A-Za-z0-9][A-Za-z0-9._:-]{4,194}$" },
        "grantVersion": { "type": "integer", "minimum": 0 },
        "relationshipId": { "type": "string", "pattern": "^rel_[A-Za-z0-9][A-Za-z0-9._:-]{2,196}$" },
        "relationshipType": { "enum": ["supervisor", "parent", "child", "peer", "dependency", "observer"] },
        "source": { "$ref": "https://threadmesh.dev/spec/0.0-draft/types.schema.json#/$defs/taskRef" },
        "target": { "$ref": "https://threadmesh.dev/spec/0.0-draft/types.schema.json#/$defs/taskRef" },
        "allowedIntents": {
          "type": "array", "minItems": 1, "uniqueItems": true,
          "items": { "enum": ["notify", "suggest", "steer", "interrupt"] }
        },
        "allowedDeliveryModes": {
          "type": "array", "minItems": 1, "uniqueItems": true,
          "items": { "$ref": "https://threadmesh.dev/spec/0.0-draft/types.schema.json#/$defs/deliveryMode" }
        },
        "summaryVisibility": { "enum": ["none", "state-only", "coordination", "objective-hint"] },
        "structuredGateResponses": { "const": false },
        "createdAt": { "type": "string", "format": "date-time" },
        "expiresAt": { "type": "string", "format": "date-time" }
      }
    },
    "request": {
      "type": "object",
      "additionalProperties": false,
      "required": ["jsonrpc", "id", "method", "params"],
      "properties": {
        "jsonrpc": { "const": "2.0" },
        "id": { "$ref": "#/$defs/rpcId" },
        "method": {
          "enum": [
            "tasks.register", "tasks.get", "tasks.attach",
            "tasks.rotateIncarnation", "tasks.publishSummary", "tasks.getSummary",
            "relationships.propose", "relationships.grant", "relationships.revoke",
            "messages.send", "messages.respond", "messages.getDisposition",
            "adapter.prepareSubmission", "adapter.beginSubmission",
            "adapter.recordReceipt", "adapter.reconcileSubmission",
            "adapter.getSubmission",
            "mailbox.listPending", "mailbox.claim", "mailbox.ack",
            "tasks.wait", "audit.list"
          ]
        },
        "params": { "type": "object" }
      },
      "allOf": [
        { "$ref": "#/$defs/registerRequest" },
        { "$ref": "#/$defs/getTaskRequest" },
        { "$ref": "#/$defs/attachRequest" },
        { "$ref": "#/$defs/rotateRequest" },
        { "$ref": "#/$defs/publishSummaryRequest" },
        { "$ref": "#/$defs/getSummaryRequest" },
        { "$ref": "#/$defs/proposeRequest" },
        { "$ref": "#/$defs/grantRequest" },
        { "$ref": "#/$defs/revokeRequest" },
        { "$ref": "#/$defs/sendRequest" },
        { "$ref": "#/$defs/respondRequest" },
        { "$ref": "#/$defs/messageReadRequest" },
        { "$ref": "#/$defs/prepareSubmissionRequest" },
        { "$ref": "#/$defs/beginSubmissionRequest" },
        { "$ref": "#/$defs/recordReceiptRequest" },
        { "$ref": "#/$defs/reconcileSubmissionRequest" },
        { "$ref": "#/$defs/getSubmissionRequest" },
        { "$ref": "#/$defs/listPendingRequest" },
        { "$ref": "#/$defs/claimRequest" },
        { "$ref": "#/$defs/ackRequest" },
        { "$ref": "#/$defs/waitRequest" }
      ]
    },
    "registerRequest": {
      "if": { "properties": { "method": { "const": "tasks.register" } } },
      "then": { "properties": { "params": {
        "type": "object", "additionalProperties": false,
        "required": ["task", "idempotencyKey"],
        "properties": { "task": { "$ref": "#/$defs/taskInput" }, "idempotencyKey": { "$ref": "#/$defs/idempotencyKey" } }
      } } }
    },
    "getTaskRequest": {
      "if": { "properties": { "method": { "const": "tasks.get" } } },
      "then": { "properties": { "params": {
        "type": "object", "additionalProperties": false, "required": ["task"],
        "properties": { "task": { "$ref": "https://threadmesh.dev/spec/0.0-draft/types.schema.json#/$defs/taskRef" } }
      } } }
    },
    "attachRequest": {
      "if": { "properties": { "method": { "const": "tasks.attach" } } },
      "then": { "properties": { "params": {
        "type": "object", "additionalProperties": false,
        "required": ["task", "adapterRef", "expectedRevision", "idempotencyKey"],
        "properties": {
          "task": { "$ref": "https://threadmesh.dev/spec/0.0-draft/types.schema.json#/$defs/taskRef" },
          "adapterRef": { "type": "object", "minProperties": 1, "maxProperties": 32 },
          "expectedRevision": { "type": "integer", "minimum": 0 },
          "idempotencyKey": { "$ref": "#/$defs/idempotencyKey" }
        }
      } } }
    },
    "rotateRequest": {
      "if": { "properties": { "method": { "const": "tasks.rotateIncarnation" } } },
      "then": { "properties": { "params": {
        "type": "object", "additionalProperties": false,
        "required": ["previous", "next", "expectedRevision", "idempotencyKey"],
        "properties": {
          "previous": { "$ref": "https://threadmesh.dev/spec/0.0-draft/types.schema.json#/$defs/taskRef" },
          "next": { "$ref": "#/$defs/taskInput" },
          "expectedRevision": { "type": "integer", "minimum": 0 },
          "idempotencyKey": { "$ref": "#/$defs/idempotencyKey" }
        }
      } } }
    },
    "publishSummaryRequest": {
      "if": { "properties": { "method": { "const": "tasks.publishSummary" } } },
      "then": { "properties": { "params": {
        "type": "object", "additionalProperties": false,
        "required": ["summary", "expectedPreviousVersion", "idempotencyKey"],
        "properties": {
          "summary": { "$ref": "https://threadmesh.dev/spec/0.0-draft/task-summary.schema.json" },
          "expectedPreviousVersion": { "type": ["integer", "null"], "minimum": 0 },
          "idempotencyKey": { "$ref": "#/$defs/idempotencyKey" }
        }
      } } }
    },
    "getSummaryRequest": {
      "if": { "properties": { "method": { "const": "tasks.getSummary" } } },
      "then": { "properties": { "params": {
        "type": "object", "additionalProperties": false, "required": ["task", "relationshipId"],
        "properties": {
          "task": { "$ref": "https://threadmesh.dev/spec/0.0-draft/types.schema.json#/$defs/taskRef" },
          "relationshipId": { "type": "string", "pattern": "^rel_[A-Za-z0-9][A-Za-z0-9._:-]{2,196}$" }
        }
      } } }
    },
    "proposeRequest": {
      "if": { "properties": { "method": { "const": "relationships.propose" } } },
      "then": { "properties": { "params": {
        "type": "object", "additionalProperties": false, "required": ["proposal", "idempotencyKey"],
        "properties": {
          "proposal": { "$ref": "https://threadmesh.dev/spec/0.0-draft/relationship-proposal.schema.json" },
          "idempotencyKey": { "$ref": "#/$defs/idempotencyKey" }
        }
      } } }
    },
    "grantRequest": {
      "if": { "properties": { "method": { "const": "relationships.grant" } } },
      "then": { "properties": { "params": {
        "type": "object", "additionalProperties": false,
        "required": ["grant", "decision", "idempotencyKey"],
        "properties": {
          "grant": { "$ref": "#/$defs/grantDraft" },
          "decision": {
            "type": "object", "additionalProperties": false, "required": ["decisionId"],
            "properties": {
              "decisionId": { "type": "string", "pattern": "^decision_[A-Za-z0-9][A-Za-z0-9._:-]{4,190}$" },
              "proposalId": { "type": "string", "pattern": "^proposal_[A-Za-z0-9][A-Za-z0-9._:-]{4,188}$" }
            }
          },
          "idempotencyKey": { "$ref": "#/$defs/idempotencyKey" }
        }
      } } }
    },
    "revokeRequest": {
      "if": { "properties": { "method": { "const": "relationships.revoke" } } },
      "then": { "properties": { "params": {
        "type": "object", "additionalProperties": false,
        "required": ["grantId", "expectedGrantVersion", "idempotencyKey"],
        "properties": {
          "grantId": { "type": "string", "pattern": "^grant_[A-Za-z0-9][A-Za-z0-9._:-]{4,194}$" },
          "expectedGrantVersion": { "type": "integer", "minimum": 0 },
          "idempotencyKey": { "$ref": "#/$defs/idempotencyKey" }
        }
      } } }
    },
    "sendRequest": {
      "if": { "properties": { "method": { "const": "messages.send" } } },
      "then": { "properties": { "params": {
        "type": "object", "additionalProperties": false, "required": ["envelope", "idempotencyKey"],
        "properties": {
          "envelope": { "$ref": "https://threadmesh.dev/spec/0.0-draft/envelope.schema.json" },
          "idempotencyKey": { "$ref": "#/$defs/idempotencyKey" }
        }
      } } }
    },
    "respondRequest": {
      "if": { "properties": { "method": { "const": "messages.respond" } } },
      "then": { "properties": { "params": {
        "type": "object", "additionalProperties": false,
        "required": ["senderIncarnationId", "messageId", "decision", "expectedRevision", "idempotencyKey"],
        "properties": {
          "senderIncarnationId": { "type": "string", "pattern": "^inc_[A-Za-z0-9][A-Za-z0-9._:-]{6,196}$" },
          "messageId": { "type": "string", "pattern": "^msg_[A-Za-z0-9][A-Za-z0-9._:-]{6,196}$" },
          "decision": { "enum": ["accepted", "rejected", "deferred"] },
          "expectedRevision": { "type": "integer", "minimum": 0 },
          "idempotencyKey": { "$ref": "#/$defs/idempotencyKey" }
        }
      } } }
    },
    "messageReadRequest": {
      "if": { "properties": { "method": { "enum": ["messages.getDisposition", "audit.list"] } } },
      "then": { "properties": { "params": {
        "type": "object", "additionalProperties": false, "required": ["senderIncarnationId", "messageId"],
        "properties": {
          "senderIncarnationId": { "type": "string", "pattern": "^inc_[A-Za-z0-9][A-Za-z0-9._:-]{6,196}$" },
          "messageId": { "type": "string", "pattern": "^msg_[A-Za-z0-9][A-Za-z0-9._:-]{6,196}$" }
        }
      } } }
    },
    "prepareSubmissionRequest": {
      "if": { "properties": { "method": { "const": "adapter.prepareSubmission" } } },
      "then": { "properties": { "params": {
        "type": "object", "additionalProperties": false,
        "required": ["senderIncarnationId", "messageId", "expectedRevision", "idempotencyKey"],
        "properties": {
          "senderIncarnationId": { "type": "string", "pattern": "^inc_[A-Za-z0-9][A-Za-z0-9._:-]{6,196}$" },
          "messageId": { "type": "string", "pattern": "^msg_[A-Za-z0-9][A-Za-z0-9._:-]{6,196}$" },
          "expectedRevision": { "type": "integer", "minimum": 0 },
          "idempotencyKey": { "$ref": "#/$defs/idempotencyKey" }
        }
      } } }
    },
    "beginSubmissionRequest": {
      "if": { "properties": { "method": { "const": "adapter.beginSubmission" } } },
      "then": { "properties": { "params": {
        "type": "object", "additionalProperties": false,
        "required": ["submissionId", "expectedRevision", "idempotencyKey"],
        "properties": {
          "submissionId": { "type": "string", "pattern": "^sub_[A-Za-z0-9][A-Za-z0-9._:-]{6,196}$" },
          "expectedRevision": { "type": "integer", "minimum": 0 },
          "idempotencyKey": { "$ref": "#/$defs/idempotencyKey" }
        }
      } } }
    },
    "recordReceiptRequest": {
      "if": { "properties": { "method": { "const": "adapter.recordReceipt" } } },
      "then": { "properties": { "params": {
        "type": "object", "additionalProperties": false,
        "required": ["submissionId", "expectedRevision", "receipt", "idempotencyKey"],
        "properties": {
          "submissionId": { "type": "string", "pattern": "^sub_[A-Za-z0-9][A-Za-z0-9._:-]{6,196}$" },
          "expectedRevision": { "type": "integer", "minimum": 0 },
          "receipt": {
            "type": "object", "additionalProperties": false,
            "required": ["adapterOperationId", "acceptedAt"],
            "properties": {
              "adapterOperationId": { "type": "string", "minLength": 1, "maxLength": 500 },
              "acceptedAt": { "type": "string", "format": "date-time" },
              "evidenceRefs": {
                "type": "array", "minItems": 1, "maxItems": 32, "uniqueItems": true,
                "items": { "$ref": "https://threadmesh.dev/spec/0.0-draft/types.schema.json#/$defs/evidenceRef" }
              }
            }
          },
          "idempotencyKey": { "$ref": "#/$defs/idempotencyKey" }
        }
      } } }
    },
    "reconcileSubmissionRequest": {
      "if": { "properties": { "method": { "const": "adapter.reconcileSubmission" } } },
      "then": { "properties": { "params": {
        "type": "object", "additionalProperties": false,
        "required": ["submissionId", "expectedRevision", "reconciliation", "idempotencyKey"],
        "properties": {
          "submissionId": { "type": "string", "pattern": "^sub_[A-Za-z0-9][A-Za-z0-9._:-]{6,196}$" },
          "expectedRevision": { "type": "integer", "minimum": 0 },
          "reconciliation": {
            "type": "object", "additionalProperties": false,
            "required": ["resolution", "evidenceRefs"],
            "properties": {
              "resolution": { "enum": ["confirmed-submitted", "confirmed-not-submitted", "manual-required"] },
              "evidenceRefs": {
                "type": "array", "minItems": 1, "maxItems": 32, "uniqueItems": true,
                "items": { "$ref": "https://threadmesh.dev/spec/0.0-draft/types.schema.json#/$defs/evidenceRef" }
              },
              "receipt": {
                "type": "object", "additionalProperties": false,
                "required": ["adapterOperationId", "acceptedAt"],
                "properties": {
                  "adapterOperationId": { "type": "string", "minLength": 1, "maxLength": 500 },
                  "acceptedAt": { "type": "string", "format": "date-time" },
                  "evidenceRefs": {
                    "type": "array", "minItems": 1, "maxItems": 32, "uniqueItems": true,
                    "items": { "$ref": "https://threadmesh.dev/spec/0.0-draft/types.schema.json#/$defs/evidenceRef" }
                  }
                }
              }
            },
            "allOf": [{
              "if": { "properties": { "resolution": { "const": "confirmed-submitted" } }, "required": ["resolution"] },
              "then": { "required": ["receipt"] }
            }]
          },
          "idempotencyKey": { "$ref": "#/$defs/idempotencyKey" }
        }
      } } }
    },
    "getSubmissionRequest": {
      "if": { "properties": { "method": { "const": "adapter.getSubmission" } } },
      "then": { "properties": { "params": {
        "type": "object", "additionalProperties": false, "required": ["submissionId"],
        "properties": {
          "submissionId": { "type": "string", "pattern": "^sub_[A-Za-z0-9][A-Za-z0-9._:-]{6,196}$" }
        }
      } } }
    },
    "listPendingRequest": {
      "if": { "properties": { "method": { "const": "mailbox.listPending" } } },
      "then": { "properties": { "params": {
        "type": "object", "additionalProperties": false, "required": ["receiver"],
        "properties": {
          "receiver": { "$ref": "https://threadmesh.dev/spec/0.0-draft/types.schema.json#/$defs/taskRef" },
          "afterCursor": { "type": "integer", "minimum": 0 },
          "limit": { "type": "integer", "minimum": 1, "maximum": 100 }
        }
      } } }
    },
    "claimRequest": {
      "if": { "properties": { "method": { "const": "mailbox.claim" } } },
      "then": { "properties": { "params": {
        "type": "object", "additionalProperties": false,
        "required": ["senderIncarnationId", "messageId", "expectedRevision", "idempotencyKey"],
        "properties": {
          "senderIncarnationId": { "type": "string", "pattern": "^inc_[A-Za-z0-9][A-Za-z0-9._:-]{6,196}$" },
          "messageId": { "type": "string", "pattern": "^msg_[A-Za-z0-9][A-Za-z0-9._:-]{6,196}$" },
          "expectedRevision": { "type": "integer", "minimum": 0 },
          "idempotencyKey": { "$ref": "#/$defs/idempotencyKey" }
        }
      } } }
    },
    "ackRequest": {
      "if": { "properties": { "method": { "const": "mailbox.ack" } } },
      "then": { "properties": { "params": {
        "type": "object", "additionalProperties": false,
        "required": ["senderIncarnationId", "messageId", "claimToken", "decision", "expectedRevision", "idempotencyKey"],
        "properties": {
          "senderIncarnationId": { "type": "string", "pattern": "^inc_[A-Za-z0-9][A-Za-z0-9._:-]{6,196}$" },
          "messageId": { "type": "string", "pattern": "^msg_[A-Za-z0-9][A-Za-z0-9._:-]{6,196}$" },
          "claimToken": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" },
          "decision": { "enum": ["accepted", "rejected", "deferred"] },
          "expectedRevision": { "type": "integer", "minimum": 0 },
          "idempotencyKey": { "$ref": "#/$defs/idempotencyKey" }
        }
      } } }
    },
    "waitRequest": {
      "if": { "properties": { "method": { "const": "tasks.wait" } } },
      "then": { "properties": { "params": {
        "type": "object", "additionalProperties": false, "required": ["task"],
        "properties": {
          "task": { "$ref": "https://threadmesh.dev/spec/0.0-draft/types.schema.json#/$defs/taskRef" },
          "afterCursor": { "type": "integer", "minimum": 0 },
          "limit": { "type": "integer", "minimum": 1, "maximum": 100 }
        }
      } } }
    },
    "successResponse": {
      "type": "object", "additionalProperties": false,
      "required": ["jsonrpc", "id", "result"],
      "properties": {
        "jsonrpc": { "const": "2.0" },
        "id": { "$ref": "#/$defs/rpcId" },
        "result": {
          "type": "object", "additionalProperties": false,
          "required": ["method", "value"],
          "properties": {
            "method": { "type": "string", "minLength": 1, "maxLength": 100 },
            "value": {}
          }
        }
      }
    },
    "errorResponse": {
      "type": "object", "additionalProperties": false,
      "required": ["jsonrpc", "id", "error"],
      "properties": {
        "jsonrpc": { "const": "2.0" },
        "id": { "type": ["string", "integer", "null"] },
        "error": {
          "type": "object", "additionalProperties": false,
          "required": ["code", "message", "data"],
          "properties": {
            "code": { "type": "integer", "maximum": -32000, "minimum": -32700 },
            "message": { "type": "string", "minLength": 1, "maxLength": 500 },
            "data": {
              "type": "object", "additionalProperties": false,
              "required": ["threadmeshCode", "retryable"],
              "properties": {
                "threadmeshCode": { "type": "string", "pattern": "^threadmesh_[a-z0-9_]+$" },
                "retryable": { "type": "boolean" },
                "detail": { "type": "string", "maxLength": 2000 }
              }
            }
          }
        }
      }
    }
  }
}
