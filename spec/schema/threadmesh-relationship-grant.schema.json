{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://threadmesh.dev/spec/0.0-draft/relationship-grant.schema.json",
  "title": "ThreadMesh relationship grant",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "specVersion",
    "grantId",
    "grantVersion",
    "relationshipId",
    "relationshipType",
    "source",
    "target",
    "allowedIntents",
    "allowedDeliveryModes",
    "summaryVisibility",
    "structuredGateResponses",
    "grantedBy",
    "authorization",
    "createdAt"
  ],
  "properties": {
    "specVersion": { "const": "0.0-draft" },
    "grantId": {
      "type": "string",
      "pattern": "^grant_[A-Za-z0-9][A-Za-z0-9._:-]{4,194}$"
    },
    "grantVersion": { "type": "integer", "minimum": 0 },
    "relationshipId": {
      "type": "string",
      "pattern": "^rel_[A-Za-z0-9][A-Za-z0-9._:-]{2,196}$"
    },
    "relationshipType": {
      "description": "Directional from source to target. supervisor means source supervises target; parent means source delegated target; child means source was delegated by target; dependency means source depends on target; observer means source observes target. peer is authority-symmetric but each grant still has a source-to-target direction.",
      "enum": ["supervisor", "parent", "child", "peer", "dependency", "observer"]
    },
    "source": {
      "$ref": "https://threadmesh.dev/spec/0.0-draft/types.schema.json#/$defs/taskRef"
    },
    "target": {
      "$ref": "https://threadmesh.dev/spec/0.0-draft/types.schema.json#/$defs/taskRef"
    },
    "allowedIntents": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "enum": ["notify", "suggest", "steer", "interrupt"] }
    },
    "allowedDeliveryModes": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "$ref": "https://threadmesh.dev/spec/0.0-draft/types.schema.json#/$defs/deliveryMode"
      }
    },
    "summaryVisibility": {
      "enum": ["none", "state-only", "coordination", "objective-hint"]
    },
    "structuredGateResponses": { "const": false },
    "grantedBy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["actorType", "actorId"],
      "properties": {
        "actorType": { "enum": ["user", "policy"] },
        "actorId": { "type": "string", "minLength": 1, "maxLength": 200 }
      }
    },
    "authorization": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "authority",
        "authenticationId",
        "decisionId",
        "decidedAt",
        "principal",
        "integrity"
      ],
      "properties": {
        "authority": { "enum": ["owner", "policy"] },
        "authenticationId": {
          "type": "string",
          "pattern": "^authn_[A-Za-z0-9][A-Za-z0-9._:-]{4,190}$"
        },
        "decisionId": {
          "type": "string",
          "pattern": "^decision_[A-Za-z0-9][A-Za-z0-9._:-]{4,190}$"
        },
        "proposalId": {
          "type": "string",
          "pattern": "^proposal_[A-Za-z0-9][A-Za-z0-9._:-]{4,188}$"
        },
        "decidedAt": { "type": "string", "format": "date-time" },
        "principal": {
          "type": "object",
          "additionalProperties": false,
          "required": ["actorType", "actorId"],
          "properties": {
            "actorType": { "enum": ["user", "policy"] },
            "actorId": { "type": "string", "minLength": 1, "maxLength": 200 }
          }
        },
        "integrity": {
          "type": "object",
          "additionalProperties": false,
          "required": ["algorithm", "digest"],
          "properties": {
            "algorithm": { "const": "sha-256" },
            "digest": {
              "type": "string",
              "pattern": "^sha256:[a-f0-9]{64}$"
            }
          }
        }
      }
    },
    "createdAt": { "type": "string", "format": "date-time" },
    "expiresAt": { "type": "string", "format": "date-time" },
    "revokedAt": { "type": "string", "format": "date-time" }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "allowedIntents": { "contains": { "const": "notify" } }
        }
      },
      "then": {
        "properties": {
          "allowedDeliveryModes": {
            "contains": { "enum": ["store-only", "side-channel"] }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "allowedIntents": { "contains": { "const": "suggest" } }
        }
      },
      "then": {
        "properties": {
          "allowedDeliveryModes": {
            "contains": {
              "enum": [
                "store-only",
                "side-channel",
                "checkpoint-offer",
                "wake-idle"
              ]
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "allowedIntents": { "contains": { "const": "steer" } }
        },
        "required": ["allowedIntents"]
      },
      "then": {
        "properties": {
          "allowedDeliveryModes": {
            "contains": { "const": "active-steer" }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "allowedIntents": { "contains": { "const": "interrupt" } }
        },
        "required": ["allowedIntents"]
      },
      "then": {
        "properties": {
          "allowedDeliveryModes": {
            "contains": { "const": "interrupt-request" }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "allowedDeliveryModes": { "contains": { "const": "active-steer" } }
        }
      },
      "then": {
        "properties": {
          "allowedIntents": { "contains": { "const": "steer" } }
        }
      }
    },
    {
      "if": {
        "properties": {
          "allowedDeliveryModes": { "contains": { "const": "interrupt-request" } }
        }
      },
      "then": {
        "properties": {
          "allowedIntents": { "contains": { "const": "interrupt" } }
        }
      }
    },
    {
      "if": {
        "properties": {
          "allowedDeliveryModes": {
            "contains": { "enum": ["checkpoint-offer", "wake-idle"] }
          }
        }
      },
      "then": {
        "properties": {
          "allowedIntents": { "contains": { "const": "suggest" } }
        }
      }
    },
    {
      "if": {
        "properties": {
          "relationshipType": { "enum": ["child", "peer", "dependency"] }
        },
        "required": ["relationshipType"]
      },
      "then": {
        "properties": {
          "allowedIntents": {
            "items": { "enum": ["notify", "suggest"] }
          },
          "allowedDeliveryModes": {
            "items": {
              "enum": [
                "store-only",
                "side-channel",
                "checkpoint-offer",
                "wake-idle"
              ]
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": { "relationshipType": { "const": "observer" } },
        "required": ["relationshipType"]
      },
      "then": {
        "properties": {
          "allowedIntents": { "items": { "const": "notify" } },
          "allowedDeliveryModes": {
            "items": { "enum": ["store-only", "side-channel"] }
          },
          "summaryVisibility": { "enum": ["none", "state-only"] }
        }
      }
    }
  ]
}
