{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://threadmesh.dev/spec/0.0-draft/conformance-manifest.schema.json",
  "title": "ThreadMesh conformance manifest",
  "type": "object",
  "additionalProperties": false,
  "required": ["specVersion", "schemaCases", "transitionCases"],
  "properties": {
    "specVersion": { "const": "0.0-draft" },
    "schemaCases": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "schema", "fixture", "valid"],
        "properties": {
          "name": { "type": "string", "minLength": 1 },
          "schema": { "type": "string", "pattern": "^schema/[^/]+\\.json$" },
          "fixture": {
            "type": "string",
            "pattern": "^conformance/fixtures/[^/]+\\.json$"
          },
          "valid": { "type": "boolean" }
        }
      }
    },
    "transitionCases": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "machine", "from", "to", "valid"],
        "properties": {
          "name": { "type": "string", "minLength": 1 },
          "machine": { "enum": ["delivery", "decision", "outcome"] },
          "from": { "type": "string", "minLength": 1 },
          "to": { "type": "string", "minLength": 1 },
          "valid": { "type": "boolean" }
        }
      }
    }
  }
}
