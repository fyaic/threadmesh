{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://threadmesh.dev/spec/0.0-draft/capabilities.schema.json",
  "title": "ThreadMesh adapter capabilities",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "specVersion",
    "adapterName",
    "adapterVersion",
    "intents",
    "deliveryModes",
    "features"
  ],
  "properties": {
    "specVersion": { "const": "0.0-draft" },
    "adapterName": { "type": "string", "minLength": 1, "maxLength": 200 },
    "adapterVersion": { "type": "string", "minLength": 1, "maxLength": 100 },
    "harness": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name"],
      "properties": {
        "name": { "type": "string", "minLength": 1, "maxLength": 200 },
        "versionRange": { "type": "string", "maxLength": 200 }
      }
    },
    "intents": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "enum": ["notify", "suggest", "steer", "interrupt"] }
    },
    "deliveryModes": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "$ref": "https://threadmesh.dev/spec/0.0-draft/types.schema.json#/$defs/deliveryMode"
      }
    },
    "features": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "relatedTaskDiscovery",
        "taskIncarnation",
        "objectiveVersioning",
        "checkpointEvents",
        "idleWake",
        "modelTurnCancellation",
        "subprocessCancellation",
        "contextAdmission",
        "provenanceRendering",
        "dispositionCallbacks",
        "structuredGateResponses"
      ],
      "properties": {
        "relatedTaskDiscovery": {
          "enum": ["none", "explicit-only", "relationship-scoped"]
        },
        "taskIncarnation": { "type": "boolean" },
        "objectiveVersioning": { "type": "boolean" },
        "checkpointEvents": { "type": "boolean" },
        "idleWake": { "type": "boolean" },
        "modelTurnCancellation": { "type": "boolean" },
        "subprocessCancellation": { "type": "boolean" },
        "contextAdmission": {
          "enum": ["none", "receiver-mediated", "native"]
        },
        "provenanceRendering": {
          "enum": ["none", "side-channel-only", "model-visible"]
        },
        "dispositionCallbacks": { "type": "boolean" },
        "structuredGateResponses": { "const": "none" }
      }
    }
  }
}
