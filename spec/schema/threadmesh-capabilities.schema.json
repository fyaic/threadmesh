{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://threadmesh.dev/spec/0.0-draft/capabilities.schema.json",
  "title": "ThreadMesh adapter capabilities",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "specVersion",
    "adapterName",
    "adapterVersion",
    "intents",
    "deliveryModes",
    "features"
  ],
  "properties": {
    "specVersion": {
      "const": "0.0-draft"
    },
    "adapterName": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200
    },
    "adapterVersion": {
      "type": "string",
      "minLength": 1,
      "maxLength": 100
    },
    "harness": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name"],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "versionRange": {
          "type": "string",
          "maxLength": 200
        }
      }
    },
    "intents": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "enum": ["notify", "suggest", "steer", "interrupt"]
      }
    },
    "deliveryModes": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "enum": ["side-channel", "mailbox", "checkpoint", "active-run"]
      }
    },
    "features": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "relatedTaskDiscovery",
        "objectiveVersioning",
        "checkpointEvents",
        "modelTurnCancellation",
        "subprocessCancellation",
        "provenanceRoles",
        "dispositionCallbacks"
      ],
      "properties": {
        "relatedTaskDiscovery": {
          "enum": ["none", "explicit-only", "relationship-scoped"]
        },
        "objectiveVersioning": {
          "type": "boolean"
        },
        "checkpointEvents": {
          "type": "boolean"
        },
        "modelTurnCancellation": {
          "type": "boolean"
        },
        "subprocessCancellation": {
          "type": "boolean"
        },
        "provenanceRoles": {
          "type": "boolean"
        },
        "dispositionCallbacks": {
          "type": "boolean"
        }
      }
    }
  }
}
