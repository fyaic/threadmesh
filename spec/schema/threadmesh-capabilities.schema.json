{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://threadmesh.dev/spec/0.0-draft/capabilities.schema.json",
  "title": "ThreadMesh adapter capabilities",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "specVersion",
    "adapterName",
    "adapterVersion",
    "intents",
    "deliveryModes",
    "features"
  ],
  "properties": {
    "specVersion": { "const": "0.0-draft" },
    "adapterName": { "type": "string", "minLength": 1, "maxLength": 200 },
    "adapterVersion": { "type": "string", "minLength": 1, "maxLength": 100 },
    "harness": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name"],
      "properties": {
        "name": { "type": "string", "minLength": 1, "maxLength": 200 },
        "versionRange": { "type": "string", "maxLength": 200 }
      }
    },
    "intents": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "enum": ["notify", "suggest", "steer", "interrupt"] }
    },
    "deliveryModes": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "$ref": "https://threadmesh.dev/spec/0.0-draft/types.schema.json#/$defs/deliveryMode"
      }
    },
    "features": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "relatedTaskDiscovery",
        "taskIncarnation",
        "objectiveVersioning",
        "checkpointEvents",
        "idleWake",
        "modelTurnCancellation",
        "subprocessCancellation",
        "contextAdmission",
        "provenanceRendering",
        "dispositionCallbacks",
        "structuredGateResponses",
        "durableSubmissionIdempotency"
      ],
      "properties": {
        "relatedTaskDiscovery": {
          "enum": ["none", "explicit-only", "relationship-scoped"]
        },
        "taskIncarnation": { "type": "boolean" },
        "objectiveVersioning": { "type": "boolean" },
        "checkpointEvents": { "type": "boolean" },
        "idleWake": { "type": "boolean" },
        "modelTurnCancellation": { "type": "boolean" },
        "subprocessCancellation": { "type": "boolean" },
        "contextAdmission": {
          "enum": ["none", "receiver-mediated", "native"]
        },
        "provenanceRendering": {
          "enum": ["none", "side-channel-only", "model-visible"]
        },
        "dispositionCallbacks": { "type": "boolean" },
        "structuredGateResponses": { "const": "none" },
        "durableSubmissionIdempotency": {
          "enum": ["none", "stable-key", "queryable-receipt"]
        }
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": { "intents": { "contains": { "const": "notify" } } }
      },
      "then": {
        "properties": {
          "deliveryModes": {
            "contains": { "enum": ["store-only", "side-channel"] }
          }
        }
      }
    },
    {
      "if": {
        "properties": { "intents": { "contains": { "const": "suggest" } } }
      },
      "then": {
        "properties": {
          "deliveryModes": {
            "contains": {
              "enum": [
                "store-only",
                "side-channel",
                "checkpoint-offer",
                "wake-idle"
              ]
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": { "intents": { "contains": { "const": "steer" } } }
      },
      "then": {
        "properties": {
          "deliveryModes": { "contains": { "const": "active-steer" } },
          "features": {
            "properties": {
              "taskIncarnation": { "const": true },
              "objectiveVersioning": { "const": true },
              "durableSubmissionIdempotency": {
                "enum": ["stable-key", "queryable-receipt"]
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": { "intents": { "contains": { "const": "interrupt" } } }
      },
      "then": {
        "properties": {
          "deliveryModes": { "contains": { "const": "interrupt-request" } },
          "features": {
            "properties": {
              "taskIncarnation": { "const": true },
              "durableSubmissionIdempotency": {
                "enum": ["stable-key", "queryable-receipt"]
              }
            },
            "anyOf": [
              {
                "properties": { "modelTurnCancellation": { "const": true } }
              },
              {
                "properties": { "subprocessCancellation": { "const": true } }
              }
            ]
          }
        }
      }
    },
    {
      "if": {
        "properties": { "deliveryModes": { "contains": { "const": "active-steer" } } }
      },
      "then": {
        "properties": { "intents": { "contains": { "const": "steer" } } }
      }
    },
    {
      "if": {
        "properties": {
          "deliveryModes": { "contains": { "const": "interrupt-request" } }
        }
      },
      "then": {
        "properties": { "intents": { "contains": { "const": "interrupt" } } }
      }
    },
    {
      "if": {
        "properties": {
          "deliveryModes": {
            "contains": { "enum": ["checkpoint-offer", "wake-idle"] }
          }
        }
      },
      "then": {
        "properties": { "intents": { "contains": { "const": "suggest" } } }
      }
    },
    {
      "if": {
        "properties": { "deliveryModes": { "contains": { "const": "wake-idle" } } }
      },
      "then": {
        "properties": {
          "features": { "properties": { "idleWake": { "const": true } } }
        }
      }
    },
    {
      "if": {
        "properties": { "features": { "properties": { "idleWake": { "const": true } } } }
      },
      "then": {
        "properties": {
          "deliveryModes": { "contains": { "const": "wake-idle" } }
        }
      }
    },
    {
      "if": {
        "properties": {
          "features": {
            "properties": {
              "contextAdmission": { "enum": ["receiver-mediated", "native"] }
            }
          }
        }
      },
      "then": {
        "properties": {
          "intents": { "contains": { "const": "suggest" } },
          "features": {
            "properties": {
              "provenanceRendering": { "const": "model-visible" }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "features": {
            "properties": {
              "relatedTaskDiscovery": { "const": "relationship-scoped" }
            }
          }
        }
      },
      "then": {
        "properties": {
          "features": { "properties": { "taskIncarnation": { "const": true } } }
        }
      }
    }
  ]
}
