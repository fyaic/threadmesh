{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://threadmesh.dev/spec/0.0-draft/envelope.schema.json",
  "title": "ThreadMesh coordination envelope",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "specVersion",
    "messageId",
    "messageType",
    "intent",
    "claimStatus",
    "sender",
    "target",
    "relationshipId",
    "content",
    "reason",
    "delivery",
    "createdAt",
    "expiresAt"
  ],
  "properties": {
    "specVersion": { "const": "0.0-draft" },
    "messageId": {
      "type": "string",
      "pattern": "^msg_[A-Za-z0-9][A-Za-z0-9._:-]{6,196}$"
    },
    "messageType": {
      "enum": [
        "observation",
        "question",
        "suggestion",
        "result",
        "state-update",
        "action-request"
      ]
    },
    "intent": {
      "enum": ["notify", "suggest", "steer", "interrupt"]
    },
    "claimStatus": {
      "enum": ["unverified", "sender-asserted", "evidence-referenced"]
    },
    "sender": {
      "type": "object",
      "additionalProperties": false,
      "required": ["taskId", "incarnationId", "actorType", "harness"],
      "properties": {
        "taskId": { "type": "string", "minLength": 1, "maxLength": 200 },
        "incarnationId": {
          "type": "string",
          "pattern": "^inc_[A-Za-z0-9][A-Za-z0-9._:-]{6,196}$"
        },
        "actorType": {
          "enum": ["user", "agent", "service", "policy"]
        },
        "actorId": { "type": "string", "minLength": 1, "maxLength": 200 },
        "harness": { "type": "string", "minLength": 1, "maxLength": 200 }
      },
      "allOf": [
        {
          "if": {
            "properties": { "actorType": { "enum": ["user", "policy"] } },
            "required": ["actorType"]
          },
          "then": { "required": ["actorId"] },
          "else": { "properties": { "actorId": false } }
        }
      ]
    },
    "target": {
      "$ref": "https://threadmesh.dev/spec/0.0-draft/types.schema.json#/$defs/taskRef"
    },
    "relationshipId": {
      "type": "string",
      "pattern": "^rel_[A-Za-z0-9][A-Za-z0-9._:-]{2,196}$"
    },
    "content": {
      "type": "string",
      "minLength": 1,
      "maxLength": 20000
    },
    "reason": {
      "type": "string",
      "minLength": 1,
      "maxLength": 2000
    },
    "evidenceRefs": {
      "type": "array",
      "maxItems": 32,
      "items": {
        "$ref": "https://threadmesh.dev/spec/0.0-draft/types.schema.json#/$defs/evidenceRef"
      },
      "uniqueItems": true
    },
    "freshness": {
      "$ref": "https://threadmesh.dev/spec/0.0-draft/types.schema.json#/$defs/freshness"
    },
    "causality": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "traceId": { "type": "string", "minLength": 1, "maxLength": 200 },
        "parentMessageId": {
          "type": "string",
          "pattern": "^msg_[A-Za-z0-9][A-Za-z0-9._:-]{6,196}$"
        },
        "hopCount": { "type": "integer", "minimum": 0, "maximum": 32 }
      }
    },
    "delivery": {
      "type": "object",
      "additionalProperties": false,
      "required": ["requestedMode", "requiresDisposition"],
      "properties": {
        "requestedMode": {
          "$ref": "https://threadmesh.dev/spec/0.0-draft/types.schema.json#/$defs/deliveryMode"
        },
        "requiresDisposition": { "type": "boolean" }
      }
    },
    "createdAt": { "type": "string", "format": "date-time" },
    "expiresAt": { "type": "string", "format": "date-time" }
  },
  "allOf": [
    {
      "if": {
        "properties": { "intent": { "enum": ["steer", "interrupt"] } },
        "required": ["intent"]
      },
      "then": {
        "properties": { "freshness": true },
        "required": ["freshness"]
      }
    },
    {
      "if": {
        "properties": { "claimStatus": { "const": "evidence-referenced" } },
        "required": ["claimStatus"]
      },
      "then": {
        "required": ["evidenceRefs"],
        "properties": { "evidenceRefs": { "minItems": 1 } }
      }
    },
    {
      "if": {
        "properties": { "intent": { "const": "notify" } },
        "required": ["intent"]
      },
      "then": {
        "properties": {
          "delivery": {
            "properties": {
              "requestedMode": { "enum": ["store-only", "side-channel"] }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": { "intent": { "const": "suggest" } },
        "required": ["intent"]
      },
      "then": {
        "properties": {
          "delivery": {
            "properties": {
              "requestedMode": {
                "enum": [
                  "store-only",
                  "side-channel",
                  "checkpoint-offer",
                  "wake-idle"
                ]
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": { "intent": { "const": "steer" } },
        "required": ["intent"]
      },
      "then": {
        "properties": {
          "delivery": {
            "properties": { "requestedMode": { "const": "active-steer" } }
          }
        }
      }
    },
    {
      "if": {
        "properties": { "intent": { "const": "interrupt" } },
        "required": ["intent"]
      },
      "then": {
        "properties": {
          "delivery": {
            "properties": {
              "requestedMode": { "const": "interrupt-request" }
            }
          }
        }
      }
    }
  ]
}
