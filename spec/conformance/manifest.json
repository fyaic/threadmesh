  "transitionCases": [
    {
      "name": "mailbox persistence follows submission",
      "machine": "delivery",
      "from": "control-plane-accepted",
      "to": "durably-received",
      "valid": true
    },
    {
      "name": "context admission follows checkpoint offer",
      "machine": "delivery",
      "from": "checkpoint-offered",
      "to": "context-admitted",
      "valid": true
    },
    {
      "name": "delivery cannot regress to control-plane acceptance",
      "machine": "delivery",
      "from": "durably-received",
      "to": "control-plane-accepted",
      "valid": false
    },
    {
      "name": "deferred advice may later be accepted",
      "machine": "decision",
      "from": "deferred",
      "to": "accepted",
      "valid": true
    },
    {
      "name": "rejected advice cannot silently become accepted",
      "machine": "decision",
      "from": "rejected",
      "to": "accepted",
      "valid": false
    },
    {
      "name": "observed effect may later be externally verified",
      "machine": "outcome",
      "from": "effect-observed",
      "to": "externally-verified",
      "valid": true
    },
    {
      "name": "verified outcome cannot regress to unobserved",
      "machine": "outcome",
      "from": "externally-verified",
      "to": "not-observed",
      "valid": false
    }
  ]
